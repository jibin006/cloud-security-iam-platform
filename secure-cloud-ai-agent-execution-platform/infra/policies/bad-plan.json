{
  "format_version": "1.2",
  "resource_changes": [
    {
      "address": "aws_security_group.admin",
      "type": "aws_security_group",
      "change": {
        "actions": ["create"],
        "after": {
          "ingress": [
            {
              "from_port": 22,
              "to_port": 22,
              "protocol": "tcp",
              "cidr_blocks": ["0.0.0.0/0"]
            }
          ]
        }
      }
    },
    {
      "address": "aws_iam_policy.admin",
      "type": "aws_iam_policy",
      "change": {
        "actions": ["create"],
        "after": {
          "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"}]}"
        }
      }
    }
  ]
}
