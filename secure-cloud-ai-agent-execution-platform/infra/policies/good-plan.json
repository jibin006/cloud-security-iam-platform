{
  "format_version": "1.2",
  "resource_changes": [
    {
      "address": "aws_security_group.app",
      "type": "aws_security_group",
      "change": {
        "actions": ["create"],
        "after": {
          "ingress": [
            {
              "from_port": 443,
              "to_port": 443,
              "protocol": "tcp",
              "cidr_blocks": ["10.0.0.0/16"]
            }
          ]
        }
      }
    },
    {
      "address": "aws_iam_policy.app",
      "type": "aws_iam_policy",
      "change": {
        "actions": ["create"],
        "after": {
          "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\"],\"Resource\":\"arn:aws:s3:::example/*\"}]}"
        }
      }
    }
  ]
}
